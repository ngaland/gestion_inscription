# Base de données
DB_URL=jdbc:postgresql://localhost:5432/gestion_inscription2
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_256_bits
